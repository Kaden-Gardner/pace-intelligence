{
  "name": "Employee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Employee Name"
    },
    "employee_number": {
      "type": "string",
      "title": "Employee Number"
    },
    "phone_number": {
      "type": "string",
      "title": "Phone Number"
    },
    "birthday": {
      "type": "string",
      "format": "date",
      "title": "Birthday (with year)"
    },
    "active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "terminated": {
      "type": "boolean",
      "title": "Terminated",
      "default": false
    },
    "is_salary": {
      "type": "boolean",
      "title": "Salary Employee",
      "default": false,
      "description": "Salary employees are paid a fixed 80 hours per pay period (40 hrs/week). Their labor is calculated as overhead distributed across all shifts (like facility cost), and they do not clock in."
    },
    "hired_for": {
      "type": "string",
      "title": "Hired For Position",
      "enum": [
        "filling",
        "pulling",
        "sorting",
        "bagging",
        "boxing"
      ]
    },
    "cross_trained_positions": {
      "type": "array",
      "title": "Cross Trained Positions",
      "items": {
        "type": "string",
        "enum": [
          "filling",
          "pulling",
          "sorting",
          "bagging",
          "boxing"
        ]
      },
      "default": []
    },
    "favorite_flavor": {
      "type": "string",
      "title": "Favorite Popsicle Flavor"
    },
    "app_role": {
      "type": "string",
      "title": "App Role",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user"
    },
    "notify_schedule_changes_only": {
      "type": "boolean",
      "title": "Notify on Schedule Changes Only",
      "default": false
    },
    "notifications_disabled": {
      "type": "boolean",
      "title": "Notifications Disabled",
      "default": false
    },
    "notify_shift_posts": {
      "type": "boolean",
      "title": "Notify on Shift Posts (Admin)",
      "default": false
    },
    "opt_out_post_notifications": {
      "type": "boolean",
      "title": "Opt Out of Post Notifications",
      "default": false
    }
  },
  "required": [
    "name",
    "employee_number"
  ]
}