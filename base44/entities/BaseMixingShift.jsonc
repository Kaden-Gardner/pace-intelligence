{
  "name": "BaseMixingShift",
  "type": "object",
  "properties": {
    "shift_date": {
      "type": "string",
      "format": "date",
      "title": "Shift Date"
    },
    "shift_time": {
      "type": "string",
      "title": "Shift Start Time"
    },
    "shift_duration": {
      "type": "number",
      "title": "Shift Duration (hours)"
    },
    "batch_size": {
      "type": "number",
      "title": "Number of Batches",
      "default": 1
    },
    "flavorset_id": {
      "type": "string",
      "title": "Flavorset"
    },
    "mixer_1": {
      "type": "string",
      "title": "Mixer 1"
    },
    "mixer_2": {
      "type": "string",
      "title": "Mixer 2"
    },
    "mixer_3": {
      "type": "string",
      "title": "Mixer 3"
    },
    "shift_lead": {
      "type": "string",
      "title": "Shift Lead"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "shift_date",
    "shift_time",
    "shift_duration",
    "batch_size",
    "flavorset_id"
  ]
}