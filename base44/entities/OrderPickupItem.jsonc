{
  "name": "OrderPickupItem",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "title": "Order ID"
    },
    "item_type": {
      "type": "string",
      "title": "Item Type",
      "enum": [
        "flavorset",
        "individual"
      ],
      "default": "flavorset"
    },
    "flavorset_id": {
      "type": "string",
      "title": "Flavorset"
    },
    "flavor_id": {
      "type": "string",
      "title": "Individual Flavor"
    },
    "pallets": {
      "type": "number",
      "title": "Pallets",
      "default": 0
    },
    "cases": {
      "type": "number",
      "title": "Cases",
      "default": 0
    },
    "case_sell_price": {
      "type": "number",
      "title": "Case Sell Price ($)",
      "default": 0
    }
  },
  "required": [
    "order_id",
    "item_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}