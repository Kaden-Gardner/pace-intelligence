        "shift_end",
        "machine_down",
        "machine_up"
      ]
    },
    "timestamp": {
      "type": "string",
      "title": "Timestamp (ISO datetime)"
    }
  },
  "required": [
    "entry_type",
    "timestamp"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}