{
  "name": "ScheduledShift",
  "type": "object",
  "properties": {
    "shift_date": {
      "type": "string",
      "format": "date",
      "title": "Shift Date"
    },
    "shift_time": {
      "type": "string",
      "title": "Shift Start Time"
    },
    "shift_duration": {
      "type": "number",
      "title": "Duration (hours)",
      "default": 8
    },
    "flavorset_id": {
      "type": "string",
      "title": "Flavorset"
    },
    "mixer_employee": {
      "type": "string",
      "title": "Mixer Employee"
    },
    "assigned_employees": {
      "type": "array",
      "title": "Working Employees",
      "items": {
        "type": "string"
      }
    },
    "on_call_employees": {
      "type": "array",
      "title": "On Call Employees",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "shift_date",
    "shift_time"
  ]
}