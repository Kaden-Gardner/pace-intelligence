{
  "name": "ScheduledShift",
  "type": "object",
  "properties": {
    "shift_date": {
      "type": "string",
      "format": "date",
      "title": "Shift Date"
    },
    "shift_time": {
      "type": "string",
      "title": "Shift Start Time"
    },
    "shift_duration": {
      "type": "number",
      "title": "Duration (hours)",
      "default": 8
    },
    "flavorset_id": {
      "type": "string",
      "title": "Flavorset"
    },
    "mixer_employee": {
      "type": "string",
      "title": "Mixer Employee"
    },
    "assigned_employees": {
      "type": "array",
      "title": "Working Employees",
      "items": {
        "type": "string"
      }
    },
    "position_assignments": {
      "type": "array",
      "title": "Position Assignments",
      "items": {
        "type": "object",
        "properties": {
          "employee_id": {
            "type": "string"
          },
          "position": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "on_call_employees": {
      "type": "array",
      "title": "On Call Employees",
      "items": {
        "type": "string"
      }
    },
    "special_order": {
      "type": "boolean",
      "title": "Special Order",
      "default": false
    },
    "special_order_name": {
      "type": "string",
      "title": "Special Order Name"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "shift_date",
    "shift_time"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}