{
  "name": "OrderPickup",
  "type": "object",
  "properties": {
    "vendor_name": {
      "type": "string",
      "title": "Vendor Name"
    },
    "flavorset_id": {
      "type": "string",
      "title": "Flavorset"
    },
    "pallets": {
      "type": "number",
      "title": "Pallets Picked Up"
    },
    "cases": {
      "type": "number",
      "title": "Cases Picked Up"
    },
    "pickup_date": {
      "type": "string",
      "format": "date",
      "title": "Pickup Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "case_sell_price": {
      "type": "number",
      "title": "Case Sell Price ($)"
    },
    "is_priced": {
      "type": "boolean",
      "title": "Has Been Priced",
      "default": false
    }
  },
  "required": [
    "vendor_name",
    "flavorset_id",
    "pallets",
    "pickup_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}