{
  "name": "SupplyPrice",
  "type": "object",
  "properties": {
    "item_key": {
      "type": "string",
      "title": "Item Key (ingredient or material key)"
    },
    "item_type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "ingredient",
        "material"
      ]
    },
    "price_per_unit": {
      "type": "number",
      "title": "Price per Unit ($)",
      "default": 0
    }
  },
  "required": [
    "item_key",
    "item_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}