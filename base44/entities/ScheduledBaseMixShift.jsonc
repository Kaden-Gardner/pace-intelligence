{
  "name": "ScheduledBaseMixShift",
  "type": "object",
  "properties": {
    "shift_date": {
      "type": "string",
      "format": "date",
      "title": "Shift Date"
    },
    "flavorset_id": {
      "type": "string",
      "title": "Flavorset"
    },
    "batch_size": {
      "type": "number",
      "title": "Number of Batches",
      "default": 1
    },
    "admin_employee": {
      "type": "string",
      "title": "Admin Working"
    },
    "mixer_1": {
      "type": "string",
      "title": "Mixer 1"
    },
    "mixer_2": {
      "type": "string",
      "title": "Mixer 2"
    },
    "mixer_3": {
      "type": "string",
      "title": "Mixer 3"
    },
    "shift_lead": {
      "type": "string",
      "title": "Shift Lead"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "shift_date",
    "flavorset_id",
    "batch_size"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}