{
  "name": "MaterialDefaults",
  "type": "object",
  "properties": {
    "material_key": {
      "type": "string",
      "title": "Material Key"
    },
    "qty_per_shift": {
      "type": "number",
      "title": "Quantity Used per Production Shift",
      "default": 0
    }
  },
  "required": [
    "material_key"
  ],
  "rls": {
