{
  "name": "MaterialInventory",
  "type": "object",
  "properties": {
    "material": {
      "type": "string",
      "title": "Material",
      "enum": [
        "individual_wrap",
        "clear_wrap",
        "popsicle_sticks",
        "gloves_small",
        "gloves_medium",
        "gloves_large",
        "gloves_xlarge",
        "box_stacks",
        "wastebasket_liners",
        "garbage_bags",
        "salt_bags",
        "tape_red",
        "tape_blue",
        "tape_clear",
        "tape_yellow",
        "tape_green",
        "paper_towel_rolls",
        "kleenex_containers",
        "water_bottles"
      ]
    },
    "quantity": {
      "type": "number",
      "title": "Quantity on Hand",
      "default": 0
    }
  },
  "required": [
    "material"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}