{
  "name": "BaseInventory",
  "type": "object",
  "properties": {
    "flavorset_id": {
      "type": "string",
      "title": "Flavorset"
    },
    "gallons": {
      "type": "number",
      "title": "Gallons on Hand",
      "default": 0
    }
  },
  "required": [
    "flavorset_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}